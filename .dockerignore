.git
node_modules
**/node_modules
.DS_Store
.env
*.log

# Build outputs are regenerated inside the Docker build. Including them in the
# context adds churn and can invalidate the `COPY . .` layer unnecessarily.
apps/web/public/assets
apps/web/public/assets-manifest.json
apps/web/public/workspace.js.map
apps/web/public/drawio

# Exclude CI metadata and non-runtime documentation. Workspace help is loaded
# during app startup and must remain in the production image.
.github
.ci-image-context
docs/*
!docs/deploy-in-workspace/
!docs/deploy-in-workspace/**
notes
readme.md
AGENTS.md
CONTEXT.md
acceptance
**/test
**/*.test.ts
**/*.test.js
**/*.test.mjs
scripts/ci-images.ts
scripts/ci-smoke-app.sh
