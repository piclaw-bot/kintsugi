<mxCell id="isolation-rules" value="Management services, non-DNS ports and peer workspace traffic stay blocked.&#xa;Off / empty upstreams → no DNS view. Disabling or deleting a workspace closes its view and cancels queries.&#xa;The last disabled view removes the internal interface. Upstream checks refresh when new bridges appear." style="rounded=1;arcSize=12;whiteSpace=none;html=0;fillColor=#fef2f2;strokeColor=#dc2626;strokeWidth=1.5;fontFamily=Arial;fontSize=18;fontColor=#0f172a;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="815" width="1300" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
