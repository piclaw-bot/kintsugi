<mxCell id="dns-optional" value="If dns = []:&#xa;keep Docker / OS defaults;&#xa;no DNS view is allocated.&#xa;Search domains apply only&#xa;with configured upstreams." style="rounded=1;arcSize=12;whiteSpace=none;html=0;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1.5;fontFamily=Arial;fontSize=18;fontColor=#0f172a;spacing=12;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;spacingLeft=0;fontSize=16;fontStyle=0;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="1000" y="1360" width="300" height="175" as="geometry"/></mxCell>
<mxCell id="constraints" value="All modes preserve management and cross-workspace isolation; no new inbound ports or subnet routes are installed.&#xa;DNS views grant only the owning workspace's TCP/UDP port 53. Public and private permissions stay separate from UI ingress.&#xa;Save settings, then park/unpark to apply them. Parking closes terminal and VS Code views.&#xa;Blue arrows: requests. Green: responses / permitted scope. Red dashed: denied attempts." style="rounded=1;arcSize=12;whiteSpace=none;html=0;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1.5;fontFamily=Arial;fontSize=18;fontColor=#0f172a;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="1600" width="1300" height="160" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
