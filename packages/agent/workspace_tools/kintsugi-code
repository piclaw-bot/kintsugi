try {
  const [operation, root, binary, config] = process.argv.slice(2);
  if (operation !== "run" || !root || !isAbsolute(root) || !binary || !config) throw Error("Usage: kintsugi-code run ROOT BINARY CONFIG");
  console.log(JSON.stringify(await run(root, binary, config)));
} catch (error) { console.log(JSON.stringify({ ok: false, error: String(error.message).slice(0, 4000) })); process.exitCode = 1; }
