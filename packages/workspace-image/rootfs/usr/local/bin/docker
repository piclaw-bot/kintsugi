#!/bin/bash
# This is guidance, not a security boundary: the container runtime denies host access.
set -euo pipefail
mapfile -t configuration < /etc/kintsugi/docker-support
case "${configuration[0]}" in
    enabled) exec /usr/local/libexec/kintsugi/docker "$@" ;;
    disabled)
        cat >&2 <<'MESSAGE'
Docker support is off for this workspace.

Kintsugi can run Docker inside workspaces, but it requires privileged mode,
which reduces isolation: agents may read or modify host data.

MESSAGE
        if [[ -n "${configuration[1]}" ]]; then
            cat >&2 <<'MESSAGE'
To enable it:
  1. Open Template settings → Container → Docker support.
  2. Select “On — privileged”.
  3. Create a new workspace from this Workspace template.

MESSAGE
            printf 'Template settings: %s\n\n' "${configuration[1]}" >&2
        else
            cat >&2 <<'MESSAGE'
To use Docker, create a workspace from a Workspace template with Docker support enabled
in Template settings → Container → Docker support.

MESSAGE
        fi
        echo 'Changing the template setting does not enable Docker in this existing workspace.' >&2
        exit 1
        ;;
    *) echo "Invalid Docker support configuration: ${configuration[0]}" >&2; exit 1 ;;
esac
