#!/bin/bash
# Bootstrap the container, then hand PID 1 and service supervision to systemd.
set -euo pipefail
mkdir -p /.kintsugi /run/systemd
rm -f /.kintsugi/ready
printf 'docker\n' > /run/systemd/container
# System services do not inherit PID 1's environment. Preserve the workspace's
# supplied environment, including multiline values, without shell evaluation.
python3 - <<'PY'
import os
with open('/.kintsugi/environment', 'w', opener=lambda path, flags: os.open(path, flags, 0o600)) as file:
    for key, value in os.environ.items():
        # Each service gets its identity from systemd, not the root bootstrap.
        if key in {"HOME", "USER", "LOGNAME", "SHELL"}:
            continue
        if key.isascii() and key.replace('_', 'a').isalnum() and not key[0].isdigit():
            escaped = value.replace('\\', '\\\\').replace('"', '\\"').replace('`', '\\`').replace('$', '\\$')
            file.write(f'{key}="{escaped}"\n')
PY
# Configure the private daemon before systemd can activate either service.
python3 - <<'PY'
import json, os
path = '/etc/kintsugi/storage.json'
driver = json.load(open(path))['driver'] if os.path.exists(path) else 'erofs'
if driver not in ('erofs', 'overlayfs'):
    raise ValueError('Invalid storage driver')
if driver == 'overlayfs':
    path = '/etc/docker/daemon.json'
    config = json.load(open(path))
    config['storage-driver'] = driver
    with open(path, 'w') as file:
        json.dump(config, file)
    path = '/etc/containerd/config.toml'
    config = open(path).read()
    original = 'default = ["erofs", "walking"]'
    if original not in config and 'default = ["walking"]' not in config:
        raise ValueError('Unsupported containerd differ configuration')
    with open(path, 'w') as file:
        file.write(config.replace(original, 'default = ["walking"]'))
PY
read -r docker_support < /etc/kintsugi/docker-support
case "$docker_support" in
    enabled)
        systemctl enable docker.socket
        ;;
    disabled)
        systemctl mask docker.socket docker.service containerd.service
        ;;
    *) echo "Invalid Docker support configuration: $docker_support" >&2; exit 1 ;;
esac
if [ -f /usr/lib/systemd/system/kintsugi-gateway.service ]; then systemctl enable kintsugi-gateway.service; fi
exec /sbin/init
